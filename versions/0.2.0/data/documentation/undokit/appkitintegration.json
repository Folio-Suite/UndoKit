{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"collectionGroup","title":"Add history to an AppKit window","modules":[{"name":"UndoKit"}],"roleHeading":"API Collection"},"topicSections":[{"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryAttachment","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryField","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"],"anchor":"Topics"}],"abstract":[{"text":"Bind native text views to a document’s typed operations and route the window’s UndoManager.","type":"text"}],"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Start with the ","type":"text"},{"code":"NoteDocument","type":"codeVoice"},{"text":" wrapper in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","type":"reference"},{"text":". Create one","type":"text"},{"text":" ","type":"text"},{"text":"presentation owner per window, sharing that wrapper when two windows show the","type":"text"},{"text":" ","type":"text"},{"text":"same document. This example binds the body field; the runnable app also binds a","type":"text"},{"text":" ","type":"text"},{"text":"title and demonstrates a local scratch editor.","type":"text"}]},{"level":2,"text":"Connect the editor","type":"heading","anchor":"Connect-the-editor"},{"syntax":"swift","code":["import AppKit","import DurableNotesCore","import UndoKit","","@MainActor final class NoteWindow: NSWindow {","    weak var historyManager: UndoManager?","    override var undoManager: UndoManager? { historyManager }","    @objc func undo(_ sender: Any?) { historyManager?.undo() }","    @objc func redo(_ sender: Any?) { historyManager?.redo() }","    override func validateUserInterfaceItem(_ item: any NSValidatedUserInterfaceItem) -> Bool {","        if item.action == #selector(undo(_:)) { return historyManager?.canUndo ?? false }","        if item.action == #selector(redo(_:)) { return historyManager?.canRedo ?? false }","        return super.validateUserInterfaceItem(item)","    }","}","","@MainActor final class NoteWindowHistory {","    let editor = NativeHistoryAppKitTextView()","    private(set) var attachment: HistoryAttachment?","    private(set) var binding: NativeHistoryAppKitBinding?","","    func connect(document: NoteDocument, window: NoteWindow) async throws {","        editor.isRichText = false","        editor.allowsUndo = true","        let attachment = try document.history.attach(owner: self)","        self.attachment = attachment","        binding = try await attachment.bindAppKit(editors: [","            (editor, try document.lease.field(.body, in: document.history))","        ])","        window.historyManager = attachment.undoManager","    }","","    func disconnect() {","        binding?.disconnect()","        binding = nil","        attachment?.disconnect()","        attachment = nil","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Retain ","type":"text"},{"code":"NoteWindowHistory","type":"codeVoice"},{"text":" in your window controller. Place its ","type":"text"},{"code":"editor","type":"codeVoice"},{"text":" inside an","type":"text"},{"text":" ","type":"text"},{"code":"NSScrollView","type":"codeVoice"},{"text":" and install that scroll view in the window’s content view. For an","type":"text"},{"text":" ","type":"text"},{"code":"NSDocument","type":"codeVoice"},{"text":" app, provide the same attachment manager through the document’s","type":"text"},{"text":" ","type":"text"},{"text":"normal UndoManager route instead of inventing another manager.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The field declaration reads the authoritative value ","type":"text"},{"inlineContent":[{"text":"and revision","type":"text"}],"type":"strong"},{"text":" and maps a","type":"text"},{"text":" ","type":"text"},{"text":"proposed string to the same ","type":"text"},{"code":"NoteChange","type":"codeVoice"},{"text":" operation used by the rename button.","type":"text"},{"text":" ","type":"text"},{"text":"Binding installs the native editing hooks; do not replace its text-view delegate","type":"text"},{"text":" ","type":"text"},{"text":"or register a second set of live Undo callbacks.","type":"text"}]},{"level":2,"text":"Commit and report readiness","type":"heading","anchor":"Commit-and-report-readiness"},{"type":"paragraph","inlineContent":[{"text":"Await ","type":"text"},{"code":"binding.commit()","type":"codeVoice"},{"text":" at an explicit ","type":"text"},{"inlineContent":[{"text":"Commit typing","type":"text"}],"type":"strong"},{"text":" action. Supported","type":"text"},{"text":" ","type":"text"},{"text":"focus\/editing-end boundaries also settle drafts. An event-loop Undo group ending","type":"text"},{"text":" ","type":"text"},{"text":"is not itself a request to persist each keystroke.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Observe ","type":"text"},{"code":"HistorySessionStatus","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"session.attach(owner:statusDidChange:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when connecting. Use ","type":"text"},{"code":"binding.permitsEditing","type":"codeVoice"},{"text":" and the status to update controls","type":"text"},{"text":" ","type":"text"},{"text":"and explain busy\/recovery states. Preserve marked text while composition finishes;","type":"text"},{"text":" ","type":"text"},{"text":"do not overwrite a live draft from a background model refresh.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Before closing a window, settle its editing and handle rejection or recovery","type":"text"},{"text":" ","type":"text"},{"text":"visibly. Then disconnect its presentation. If it was the last owner of the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"document","type":"text"}],"type":"strong"},{"text":", explicitly await session closure and check ","type":"text"},{"code":".closed","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"text":"Try it","type":"heading","anchor":"Try-it"},{"type":"paragraph","inlineContent":[{"text":"In the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"type, use Cmd-Z\/Shift-Cmd-Z, commit, then close and reopen. A local scratch editor","type":"text"},{"text":" ","type":"text"},{"text":"uses only its own history: an empty local Undo stack must not fall through to an","type":"text"},{"text":" ","type":"text"},{"text":"older document edit. Two windows for the same document share session ordering;","type":"text"},{"text":" ","type":"text"},{"text":"two different documents keep independent scopes.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/undokit\/appkitintegration"]}],"kind":"article","identifier":{"url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"],"anchor":"Get-started","title":"Get started"}],"references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit/UIKitIntegration":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Keep a native text view and its history binding with the scene’s document presentation.","type":"text"}],"url":"\/documentation\/undokit\/uikitintegration","kind":"article","title":"Add history to a UIKit scene","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/FirstUndoGroup":{"role":"article","type":"topic","abstract":[{"text":"Open a document, submit a typed edit, then Undo, Redo and reopen it.","type":"text"}],"url":"\/documentation\/undokit\/firstundogroup","kind":"article","title":"Your first Undo Group","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HostingYourModel":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Replace the example’s domain host while keeping session and presentation wiring.","type":"text"}],"url":"\/documentation\/undokit\/hostingyourmodel","kind":"article","title":"Connect your own model","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryField":{"role":"symbol","type":"topic","abstract":[{"text":"Declares one optional field draft and its mapping to an ordinary typed operation.","type":"text"},{"text":" ","type":"text"},{"text":"The host reads authoritative revisions and defines semantic intent; UndoKit owns its journal.","type":"text"}],"url":"\/documentation\/undokit\/historyfield","kind":"symbol","title":"HistoryField","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryField","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistoryField","kind":"identifier"}],"navigatorTitle":[{"text":"HistoryField","kind":"identifier"}]},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryAttachment":{"role":"symbol","type":"topic","abstract":[{"text":"Connects one window or scene to a shared document session.","t