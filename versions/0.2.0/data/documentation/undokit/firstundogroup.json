{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"UndoKit"}],"title":"Your first Undo Group"},"abstract":[{"type":"text","text":"Open a document, submit a typed edit, then Undo, Redo and reopen it."}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Run-something-first","text":"Run something first","level":2},{"type":"paragraph","inlineContent":[{"text":"Clone the repository, select Xcode 27.1 (27A9275), and run an example from its root:","type":"text"}]},{"type":"codeListing","syntax":"sh","code":["ruby scripts\/run-durable-notes.rb --launch"]},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Document A"}]},{"text":", choose ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Apply grouped example"}]},{"text":". Its title becomes ","type":"text"},{"code":"Shopping","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and its body becomes ","type":"text"},{"code":"Tea and bread","type":"codeVoice"},{"text":". Undo restores both fields together; Redo","type":"text"},{"text":" ","type":"text"},{"text":"restores both. Type into the body: native Undo\/Redo now walks the live typing","type":"text"},{"text":" ","type":"text"},{"text":"history. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Commit typing"}]},{"text":" settles that draft into a durable Undo Group.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There are also ","type":"text"},{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/UIKit","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUIApp","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUI","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"apps. Their READMEs give launch commands and interactive exercises.","type":"text"}]},{"type":"heading","anchor":"Open-one-shared-document-session","text":"Open one shared document session","level":2},{"type":"paragraph","inlineContent":[{"text":"The following snippets use ","type":"text"},{"code":"NotesDocumentLease","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"NoteChange","type":"codeVoice"},{"text":" from the sample’s","type":"text"},{"text":" ","type":"text"},{"code":"DurableNotesCore","type":"codeVoice"},{"text":" product. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Those are app-owned example types, not UndoKit API."}]},{"text":" ","type":"text"},{"text":"The lease opens ","type":"text"},{"code":"Note.json","type":"codeVoice"},{"text":", retains its writer lock, and registers a typed change","type":"text"},{"text":" ","type":"text"},{"text":"handler. UndoKit owns the separate history database and draft journal.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Keep a ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessions","type":"reference","isActive":true},{"text":" collection in your app owner. Pass that same collection","type":"text"},{"text":" ","type":"text"},{"text":"when opening documents, and keep the returned document owner outside transient","type":"text"},{"text":" ","type":"text"},{"text":"views. This small wrapper is shared by the three platform guides:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import DurableNotesCore","import UndoKit","","@MainActor final class NoteDocument {","    let history: HistorySession","    let lease: NotesDocumentLease","    let changes: HistoryCommands<NoteChange>","","    private init(history: HistorySession, lease: NotesDocumentLease) throws {","        self.history = history","        self.lease = lease","        changes = try lease.commands(in: history)","    }","","    static func open(","        at directory: URL, mode: HistoryOpenMode, in sessions: HistorySessions","    ) async throws -> NoteDocument {","        let lease = NotesDocumentLease(directory: directory)","        let history = await sessions.open(","            documentURL: directory, mode: mode, lease: lease","        ) {","            try await lease.setup(mode: mode)","        }","        guard history.status.phase == .ready else {","            throw history.status.issue ?? HistoryFailure(","                .storage, stage: .admission, disposition: .suspended)","        }","        return try NoteDocument(history: history, lease: lease)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":".create","type":"codeVoice"},{"text":" only for a deliberately new document, ","type":"text"},{"code":".existing","type":"codeVoice"},{"text":" when reopening a","type":"text"},{"text":" ","type":"text"},{"text":"known one. Persist the document’s scope and working identity; never generate new","type":"text"},{"text":" ","type":"text"},{"text":"identities each launch to get around an opening failure. The sample stores them","type":"text"},{"text":" ","type":"text"},{"text":"in its domain file. A partial or missing known document is an error, not a reason","type":"text"},{"text":" ","type":"text"},{"text":"to create replacement history.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Open this wrapper ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"once per document"}]},{"text":", then share it between presentations.","type":"text"},{"text":" ","type":"text"},{"text":"The lease and operation declaration have stable identity while open. The complete","type":"text"},{"text":" ","type":"text"},{"text":"sample registry also deduplicates requests for the same document and handles","type":"text"},{"text":" ","type":"text"},{"text":"blocked acquisition; use that pattern for a multiwindow app. A blocked session","type":"text"},{"text":" ","type":"text"},{"text":"remains retained by the application collection so recovery can finish.","type":"text"}]},{"type":"heading","anchor":"Submit-application-intent","text":"Submit application intent","level":2},{"type":"paragraph","inlineContent":[{"text":"Here is a rename button’s action. Read the current title, filter a known no-op,","type":"text"},{"text":" ","type":"text"},{"text":"and submit a typed value. The example handler validates the expected title before","type":"text"},{"text":" ","type":"text"},{"text":"accepting it, so a stale read cannot overwrite a concurrent accepted edit.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","func renameNote(_ document: NoteDocument, to title: String) async throws","    -> HistorySubmissionResult? {","    let oldTitle = try await document.lease.read().note.title","    guard oldTitle != title else { return nil }","    return await document.changes.submit(","        NoteChange(field: .title, expected: oldTitle, replacement: title))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For title and body changes that must succeed together, call "},{"code":"submitGroup","type":"codeVoice"},{"type":"text","text":" with"},{"text":" ","type":"text"},{"text":"both values on the same typed handle. One host callback accepts the complete","type":"text"},{"text":" ","type":"text"},{"text":"ordered group atomically. Your editing call sites do not assign transaction","type":"text"},{"text":" ","type":"text"},{"text":"identities, encode payloads or take whole-document snapshots.","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Result","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"What your UI should do"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".accepted"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Show the accepted state; also check session readiness before enabling input."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".rejected","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Explain that validation declined the request; no semantic effect was accepted."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unexecuted"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The request did not reach delivery. After resolving its cause, let the user submit fresh intent."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".failed","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A usable failure was established. Inspect the failure and current status."}]}]],[[{"type":"paragraph","inlineContent":[{"code":".unresolved","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keep recovery visible and editing blocked; reconcile the original request.","type":"text"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The helper returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for its local no-op; that request never enters UndoKit."}],"type":"paragraph"},{"text":"Undo, Redo and close","level":2,"type":"heading","anchor":"Undo-Redo-and-close"},{"inlineContent":[{"type":"text","text":"You can await "},{"type":"codeVoice","code":"document.history.undo()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"redo()"},{"type":"text","text":" for application controls, or"},{"type":"text","text":" "},{"type":"text","text":"supply a presentation attachment’s UndoManager to native menus and responders."},{"type":"text","text":" "},{"type":"text","text":"The platform guides show the latter. Native live typing and settled application"},{"type":"text","text":" "},{"type":"text","text":"history share that route without persisting each keystroke."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"At the "},{"type":"strong","inlineContent":[{"type":"text","text":"document"}]},{"text":" ownership boundary, await ","type":"text"},{"code":"document.history.close()","type":"codeVoice"},{"text":" and check","type":"text"},{"text":" ","type":"text"},{"text":"that its phase is ","type":"text"},{"type":"codeVoice","code":".closed"},{"text":". A blocked close retains recovery ownership; do not","type":"text"},{"type":"text","text":" "},{"type":"text","text":"release or replace the domain resources prematurely. Closing one window of a"},{"type":"text","text":" "},{"type":"text","text":"shared document only disconnects that window’s attachment."}],"type":"paragraph"},{"inlineContent":[{"text":"Reopen with ","type":"text"},{"code":".existing","type":"codeVoice"},{"type":"text","text":", read the host’s state and receipts, and check Undo\/Redo"},{"text":" ","type":"text"},{"type":"text","text":"availability. Reopening reconciles authoritative outcomes; it does not redeliver"},{"type":"text","text":" "},{"text":"accepted changes. Recovered field drafts require a deliberate retry\/discard choice.","type":"text"}],"type":"paragraph"},{"text":"Next","level":2,"type":"heading","anchor":"Next"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"}]}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/undokit\/firstundogroup"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup"},"kind":"article","hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit"]]},"seeAlsoSections":[{"title":"Get started","generated":true,"anchor":"Get-started","identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"]}],"references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit/InstallingUndoKit":{"role":"collectionGroup","abstract":[{"text":"Select one dynamic runtime and resource owner per process.","type":"text"}],"title":"Installing UndoKit","kind":"article","type":"topic","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","url":"\/documentation\/undokit\/installingundokit"},"https://github.com/Folio-Suite/UndoKit/tree/main/Examples/DurableNotes/SwiftUIApp":{"title":"SwiftUI Mac","identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUIApp","titleInlineContent":[{"text":"SwiftUI Mac","type":"text"}],"url":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUIApp","