 and Redo for Swift apps, with the native editing behavior people expect."}],"url":"\/documentation\/undokit","kind":"symbol","title":"UndoKit","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"},"https://github.com/Folio-Suite/UndoKit/tree/main/Examples/DurableNotes/UIKit":{"title":"UIKit","identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/UIKit","titleInlineContent":[{"text":"UIKit","type":"text"}],"url":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/UIKit","type":"link"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/RecoveryAndStorage":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Preserve exact intent and authoritative evidence across uncertainty.","type":"text"}],"url":"\/documentation\/undokit\/recoveryandstorage","kind":"article","title":"Recovery, storage and concurrency","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/SwiftUIIntegration":{"role":"collectionGroup","abstract":[{"text":"Let SwiftUI compose the screen while a stable owner retains the editor, binding and session.","type":"text"}],"title":"Present native history in SwiftUI","kind":"article","type":"topic","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration","url":"\/documentation\/undokit\/swiftuiintegration"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/UIKitIntegration":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Keep a native text view and its history binding with the scene’s document presentation.","type":"text"}],"url":"\/documentation\/undokit\/uikitintegration","kind":"article","title":"Add history to a UIKit scene","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration"}}}