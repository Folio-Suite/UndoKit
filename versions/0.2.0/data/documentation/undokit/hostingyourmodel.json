{"topicSections":[{"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryOperation","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryOperationHandler","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/MainActorHistoryOperationHandler","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryHostLease","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessionSetup","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryField","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"],"anchor":"Topics"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/undokit\/hostingyourmodel"]}],"abstract":[{"type":"text","text":"Replace the example’s domain host while keeping session and presentation wiring."}],"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"]]},"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The platform guides use "},{"code":"DurableNotesCore","type":"codeVoice"},{"type":"text","text":" so the storage and recovery contract is"},{"type":"text","text":" "},{"type":"text","text":"runnable rather than hidden behind placeholders. Your app supplies the equivalent"},{"type":"text","text":" "},{"type":"text","text":"of its "},{"code":"NoteChange","type":"codeVoice"},{"type":"text","text":", "},{"code":"DurableNotesHost","type":"codeVoice"},{"type":"text","text":" and "},{"code":"NotesDocumentLease","type":"codeVoice"},{"type":"text","text":". You do not need to"},{"type":"text","text":" "},{"type":"text","text":"adopt its JSON datastore or expose UndoKit’s storage internals."}]},{"type":"heading","text":"Define one semantic operation","anchor":"Define-one-semantic-operation","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A Command describes "},{"inlineContent":[{"type":"text","text":"intent"}],"type":"strong"},{"type":"text","text":", such as replacing a title only if it still has"},{"type":"text","text":" "},{"type":"text","text":"an expected value. An effect records enough information to undo and redo an"},{"type":"text","text":" "},{"type":"text","text":"accepted change. They can be the same Swift type, as in Durable Notes, or different"},{"type":"text","text":" "},{"type":"text","text":"types. Keep them transferable when using "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryOperation","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register each operation once with a stable family, versioned codecs, actual host"},{"type":"text","text":" "},{"type":"text","text":"handler and canonical Intent Fingerprint. This excerpt is the sample’s declaration,"},{"type":"text","text":" "},{"type":"text","text":"created after opening its domain host:"}]},{"syntax":"swift","type":"codeListing","code":["import Foundation","import DurableNotesCore","import UndoKit","","func noteOperation<Handler: HistoryOperationHandler>(","    handler: Handler",") throws -> HistoryOperation<NoteChange>","where Handler.Command == NoteChange, Handler.Effect == NoteChange {","    try HistoryOperation(","        operation: \"durable-notes.change\",","        commandCodec: .json(), effectCodec: .json(), handler: handler,","        fingerprint: { changes in","            let encoder = JSONEncoder()","            encoder.outputFormatting = [.sortedKeys]","            return try encoder.encode(changes)","        })","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep this declaration and its handler for the session lifetime. Recreating a"},{"type":"text","text":" "},{"type":"text","text":"lookalike operation for each button press does not preserve registration identity."},{"type":"text","text":" "},{"type":"text","text":"Get "},{"code":"session.commands(for: operation)","type":"codeVoice"},{"type":"text","text":" once, then pass that typed handle to your"},{"type":"text","text":" "},{"type":"text","text":"editing code. Fingerprints represent canonical intent; they are not a fresh UUID"},{"type":"text","text":" "},{"type":"text","text":"or a claim that a previous request succeeded."}]},{"type":"heading","text":"Apply effects and receipts together","anchor":"Apply-effects-and-receipts-together","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implement "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryOperationHandler","type":"reference","isActive":true},{"type":"text","text":" on an actor, or"},{"type":"text","text":" "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/MainActorHistoryOperationHandler","type":"reference","isActive":true},{"type":"text","text":" when the domain belongs on MainActor. Both"},{"type":"text","text":" "},{"type":"text","text":"provide "},{"code":"apply","type":"codeVoice"},{"type":"text","text":", "},{"code":"undo","type":"codeVoice"},{"type":"text","text":", "},{"code":"redo","type":"codeVoice"},{"type":"text","text":" and authoritative "},{"code":"outcome(for:)","type":"codeVoice"},{"type":"text","text":" lookup."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For each delivered group:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Look up its complete token in your durable receipt store. If it already has an","type":"text"},{"text":" ","type":"text"},{"text":"outcome, return that outcome without applying effects again.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Validate ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"all"}]},{"text":" members against the current domain state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Commit the group’s complete effect and token-bound receipt atomically in your","type":"text"},{"text":" ","type":"text"},{"text":"own datastore. Never accept a partial group.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Return the corresponding typed effects, preserving each delivered member ID.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Undo and Redo are new deliveries with their own tokens. Their effects and receipts"},{"type":"text","text":" "},{"type":"text","text":"follow the same atomicity rule. For a mixed-family atomic group, provide the paired"},{"type":"text","text":" "},{"type":"text","text":"atomic executor\/outcome callbacks in "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessionSetup","type":"reference","isActive":true},{"type":"text","text":"; independent family"},{"type":"text","text":" "},{"type":"text","text":"callbacks cannot establish a shared atomic commit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample commits its note and receipts in one atomic JSON-file replacement"},{"type":"text","text":" "},{"type":"text","text":"under an exclusive writer lock. A Core Data host would normally persist them in"},{"type":"text","text":" "},{"type":"text","text":"one coordinated domain transaction instead. This is your application’s transaction,"},{"type":"text","text":" "},{"type":"text","text":"separate from UndoKit’s history finalization."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a write might have succeeded, return "},{"code":".unresolved","type":"codeVoice"},{"type":"text","text":" until authoritative lookup"},{"type":"text","text":" "},{"type":"text","text":"can prove its outcome. A timeout or thrown write is not proof of rejection."},{"type":"text","text":" "},{"type":"text","text":"The sample reloads its file before answering recovery lookup. It can treat a"},{"type":"text","text":" "},{"type":"text","text":"missing token in an intact file as rejection only because its single-writer,"},{"type":"text","text":" "},{"type":"text","text":"atomic-file contract proves that no corresponding effect committed."}]},{"type":"heading","text":"Give the session a domain lease","anchor":"Give-the-session-a-domain-lease","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryHostLease","type":"reference","isActive":true},{"type":"text","text":" acquires and releases only your domain resources. Its"},{"type":"text","text":" "},{"type":"text","text":"initializer must not acquire them: the application collection retains ownership"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"type":"text","text":" calling "},{"code":"open","type":"codeVoice"},{"type":"text","text":". Use the asynchronous configure closure when operation"},{"type":"text","text":" "},{"type":"text","text":"setup needs the opened host, as shown in "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessionSetup","type":"reference","isActive":true},{"type":"text","text":" names the history URL, stable scope and"},{"type":"text","text":" "},{"type":"text","text":"working identity and registered operations. UndoKit opens\/closes its own storage"},{"type":"text","text":" "},{"type":"text","text":"and journals, then releases the domain lease after successful closure. A failed"},{"type":"text","text":" "},{"type":"text","text":"close keeps the responsible owner. Reuse the same lease when reopening an already"},{"type":"text","text":" "},{"type":"text","text":"live document; prefer sharing the document wrapper rather than opening it twice."}]},{"type":"heading","text":"Map native fields","anchor":"Map-native-fields","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryField","type":"reference","isActive":true},{"type":"text","text":" declares a stable field ID and mapping ID, codec, typed handle,"},{"type":"text","text":" "},{"type":"text","text":"authoritative value\/revision read and a mapping from the base snapshot plus"},{"type":"text","text":" "},{"type":"text","text":"proposed value to Commands. Return an empty array for a known no-op. Equal visible"},{"type":"text","text":" "},{"type":"text","text":"values are not enough to establish that the authoritative revision is unchanged."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample uses its application counter as the revision because all its accepted"},{"type":"text","text":" "},{"type":"text","text":"changes pass through one writer. Use your domain’s real revision scheme when"},{"type":"text","text":" "},{"type":"text","text":"other writers or external edits are possible. Bind this field through the native"},{"type":"text","text":" "},{"type":"text","text":"platform adapters; they handle draft capture, settlement and refresh."}]},{"type":"heading","text":"Keep ordinary call sites small","anchor":"Keep-ordinary-call-sites-small","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A rename button should submit a typed rename. It should not assemble payloads,"},{"type":"text","text":" "},{"type":"text","text":"manage a retry identity, take a whole-document snapshot or open its own history"},{"type":"text","text":" "},{"type":"text","text":"store. Use "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryStore","type":"reference","isActive":true},{"type":"text","text":"\/"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryEngine","type":"reference","isActive":true},{"type":"text","text":" directly only for a deliberately"},{"type":"text","text":" "},{"type":"text","text":"lower-level integration; do not open a competing owner beneath a shared session."}]},{"type":"heading","text":"Source to study","anchor":"Source-to-study","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/blob\/main\/Examples\/DurableNotes\/Sources\/DurableNotesCore\/Note.swift","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/blob\/main\/Examples\/DurableNotes\/Sources\/DurableNotesCore\/DurableNotesHost.swift","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/blob\/main\/Examples\/DurableNotes\/Sources\/DurableNotesCore\/NotesDocumentLease.swift","type":"reference","isActive":true}]}]}]}]}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Connect your own model","modules":[{"name":"UndoKit"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Get started","generated":true,"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration"],"anchor":"Get-started"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"},"references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit/MainActorHistoryOperationHandler":{"role":"symbol","abstract":[{"text":"A main-actor variant f