{"topicSections":[{"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryFailure","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryStore","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryEngine","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryHost","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RetainedHistoryAndResources","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/PreviewCompatibilityAndSupport"],"anchor":"Topics"}],"variants":[{"paths":["\/documentation\/undokit\/recoveryandstorage"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Preserve exact intent and authoritative evidence across uncertainty."}],"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration"]]},"sections":[],"kind":"article","primaryContentSections":[{"content":[{"anchor":"Show-the-next-action","level":2,"type":"heading","text":"Show the next action"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep session status visible to the person editing the document. A disabled"},{"type":"text","text":" "},{"type":"text","text":"editor without an explanation is difficult to distinguish from a broken app."}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"What you observe","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Next step","type":"text"}]}]],[[{"inlineContent":[{"text":"Busy delivery","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keep the owner; wait for the authoritative result."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"requiresDraftDecision"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Offer ","type":"text"},{"code":"retryDraft()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"discardDraft()","type":"codeVoice"},{"text":" with an explanation of the retained draft.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Suspended transaction","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Await ","type":"text"},{"code":"session.reconcile()","type":"codeVoice"},{"text":"; it consults the original host receipt.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Storage unavailable","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Restore access to the original document, then finish closure before reopening it.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Close did not reach ","type":"text"},{"code":".closed","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keep the session\/domain lease and report the blocking issue.","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the session or binding’s supported methods, rather than clearing native"},{"type":"text","text":" "},{"type":"text","text":"registrations, resetting a generation or opening another history store. A retry"},{"type":"text","text":" "},{"type":"text","text":"of a retained draft and a new Command are different operations."}]},{"anchor":"Acceptance-is-host-authoritative","level":2,"type":"heading","text":"Acceptance is host-authoritative"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host’s domain state and outcome receipt must agree atomically. If a delivery"},{"type":"text","text":" "},{"type":"text","text":"may have changed state, report unresolved until authoritative lookup establishes"},{"type":"text","text":" "},{"type":"text","text":"acceptance or rejection. UndoKit preserves prepared intent and suspends unsafe"},{"type":"text","text":" "},{"type":"text","text":"inverses while it reconciles. Never invent a fresh identity, clear unknown native"},{"type":"text","text":" "},{"type":"text","text":"registrations, or fall through to an older group to escape this uncertainty."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The durable samples include a Debug-only control that accepts an effect before"},{"type":"text","text":" "},{"type":"text","text":"history finalization fails. Graceful close\/reopen then recovers the original"},{"type":"text","text":" "},{"type":"text","text":"Accepted Outcome using its authoritative receipt without duplicating the effect."},{"type":"text","text":" "},{"type":"text","text":"This is injected production-boundary recovery evidence, not abrupt-termination"},{"type":"text","text":" "},{"type":"text","text":"certification. Release builds omit the Debug injection control."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A reopened retained draft is decision-gated. The host explicitly retries or"},{"type":"text","text":" "},{"type":"text","text":"discards the preserved draft; ordinary editing does not silently accept it."},{"type":"text","text":" "},{"type":"text","text":"App-owned session collections retain blocked complete leases after presentation"},{"type":"text","text":" "},{"type":"text","text":"is released. Close the blocked session before reopening storage that has returned."}]},{"anchor":"Preserve-original-storage","level":2,"type":"heading","text":"Preserve original storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Missing known history, corrupt bytes, an incompatible model or an identity"},{"type":"text","text":" "},{"type":"text","text":"conflict must be refused and preserved. Do not silently replace them with empty"},{"type":"text","text":" "},{"type":"text","text":"history or reset a generation. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryStore"},{"type":"text","text":" opening validates supported model"},{"type":"text","text":" "},{"type":"text","text":"and identity before writable access; the host still coordinates external writers,"},{"type":"text","text":" "},{"type":"text","text":"moves, document resources and copies."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A coordinated copy pairs closed history with coherent host data and dependencies."},{"type":"text","text":" "},{"type":"text","text":"Unresolved work blocks an ordinary independent copy. Storage capacity checks can"},{"type":"text","text":" "},{"type":"text","text":"refuse before copying. History is not the primary datastore or a backup for"},{"type":"text","text":" "},{"type":"text","text":"missing host resources. Keep a recoverable coherent original for any supported"},{"type":"text","text":" "},{"type":"text","text":"upgrade; there is no downgrade guarantee."}]},{"anchor":"Respect-actor-and-lifecycle-ownership","level":2,"type":"heading","text":"Respect actor and lifecycle ownership"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Session\/capability calls and native presentation are MainActor isolated. A host"},{"type":"text","text":" "},{"type":"text","text":"handler may own another actor; immutable encoded values cross that boundary."},{"type":"text","text":" "},{"type":"text","text":"Applications establish intended submission order before admission. Each scope"},{"type":"text","text":" "},{"type":"text","text":"serializes delivery, but do not await another submission to the same scope from"},{"type":"text","text":" "},{"type":"text","text":"inside its host callback."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation after delivery cannot retract its semantic effect. Presentation"},{"type":"text","text":" "},{"type":"text","text":"teardown disconnects recognized callback graphs while the app retains recovery"},{"type":"text","text":" "},{"type":"text","text":"ownership as needed. Call explicit close and await delivered work reaching a"},{"type":"text","text":" "},{"type":"text","text":"recoverable boundary before releasing the domain lease. A disappearing window"},{"type":"text","text":" "},{"type":"text","text":"is not a guarantee that persistence succeeded."}]}],"kind":"content"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"UndoKit"}],"title":"Recovery, storage and concurrency"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"title":"Recovery and retained history","generated":true,"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RetainedHistoryAndResources","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/PreviewCompatibilityAndSupport","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryFailure","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryReading","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryRetentionManaging"],"anchor":"Recovery-and-retained-history"}],"identifier":{"url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage","interfaceLanguage":"swift"},"references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryHost":{"role":"symbol","type":"topic","abstract":[{"text":"A host adapter must persist an accepted receipt with its semantic mutation.","type":"text"},{"text":" ","type":"text"},{"text":"Implementations may be isolated to any actor. Only opaque, Sendable history","type":"text"},{"text":" ","type":"text"},{"text":"values cross this boundary; domain values remain on the host’s actor.","type":"text"},{"text":" ","type":"text"},{"text":"Outcome lookup never applies a command again.","type":"text"}],"url":"\/documentation\/undokit\/historyhost","kind":"symbol","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryHost","title":"HistoryHost","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistoryHost"}],"navigatorTitle":[{"kind":"identifier","text":"HistoryHost"}]},"doc://dev.foliosuite.UndoKit/documentation/UndoKit":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Durable Undo and Redo for Swift apps, with the native editing behavior people expect."}],"url":"\/documentation\/undokit","kind":"symbol","title":"UndoKit","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/RetainedHistoryAndResources":{"abstract":[{"type":"text","text":"Browsing retained History does not move ordinary Undo\/Redo position."}],"type":"topic","role":"collectionGroup","kind":"article","url":"\/documentation\/undokit\/retainedhistoryandresources","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RetainedHistoryAndResources","title":"Retained history, checkpoints and resources"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryEngine":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistoryEngine","kind":"identifier"}],"navigatorTitle":[{"text":"HistoryEngine","kind":"identifier"}],"abstract":[{"text":"An open History Scope and its lifecycle controls.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/undokit\/historyengine","title":"HistoryEngine","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryEngine"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/SwiftUIIntegration":{"role":"collectionGroup","abstract":[{"text":"Let SwiftUI compose the screen while a stable o