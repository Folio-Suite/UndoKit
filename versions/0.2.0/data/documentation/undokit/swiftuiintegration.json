{"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Present native history in SwiftUI","modules":[{"name":"UndoKit"}]},"topicSections":[{"anchor":"Topics","identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/NativeHistorySwiftUIEditor","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryAttachment","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"]}],"abstract":[{"text":"Let SwiftUI compose the screen while a stable owner retains the editor, binding and session.","type":"text"}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the document setup in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup"},{"type":"text","text":" and the appropriate native binding"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/NativeHistorySwiftUIEditor"},{"type":"text","text":" "},{"type":"text","text":"presents that "},{"type":"strong","inlineContent":[{"text":"existing","type":"text"}]},{"type":"text","text":" editor. It does not open another session or turn a"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI "},{"type":"codeVoice","code":"TextEditor"},{"type":"text","text":" into durable history."}],"type":"paragraph"},{"text":"Keep native objects outside the view value","level":2,"anchor":"Keep-native-objects-outside-the-view-value","type":"heading"},{"inlineContent":[{"type":"text","text":"This presentation owner holds one bound native editor and publishes session"},{"type":"text","text":" "},{"type":"text","text":"status. It shares the "},{"type":"codeVoice","code":"NoteDocument"},{"type":"text","text":" from the first guide rather than opening its"},{"type":"text","text":" "},{"type":"text","text":"own session. The platform-specific part is only the native editor and binding:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import UndoKit","#if canImport(AppKit)","import AppKit","#elseif canImport(UIKit)","import UIKit","#endif","","@MainActor final class SwiftUINotePresentation: ObservableObject {","    #if canImport(AppKit)","    let editor = NativeHistoryAppKitTextView()","    @Published private(set) var binding: NativeHistoryAppKitBinding?","    #else","    let editor = NativeHistoryTextView()","    @Published private(set) var binding: NativeHistoryUIKitBinding?","    #endif","    @Published private(set) var status: HistorySessionStatus","    private let document: NoteDocument","    private var attachment: HistoryAttachment?","","    init(document: NoteDocument) {","        self.document = document","        status = document.history.status","    }","","    func connect() async throws {","        guard attachment == nil else { return }","        let attachment = try document.history.attach(owner: self) { owner, status in","            owner.status = status","        }","        self.attachment = attachment","        do {","            let body = try document.lease.field(.body, in: document.history)","            #if canImport(AppKit)","            editor.isRichText = false","            editor.allowsUndo = true","            binding = try await attachment.bindAppKit(editors: [(editor, body)])","            #else","            binding = try await attachment.bindUIKit(editors: [(editor, body)])","            #endif","        } catch {","            attachment.disconnect()","            self.attachment = nil","            throw error","        }","    }","","    func disconnect() {","        binding?.disconnect()","        binding = nil","        attachment?.disconnect()","        attachment = nil","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Keep this owner in your application’s scene\/document model (for example with"},{"type":"text","text":" "},{"type":"codeVoice","code":"@StateObject"},{"type":"text","text":"). Await "},{"type":"codeVoice","code":"connect()"},{"type":"text","text":" before presenting the editor and display any"},{"type":"text","text":" "},{"type":"text","text":"opening error. The view observes the existing owner:"}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor struct NoteEditor: View {","    @ObservedObject var presentation: SwiftUINotePresentation","","    var body: some View {","        if let binding = presentation.binding {","            VStack {","                NativeHistorySwiftUIEditor(textView: presentation.editor)","                NoteUndoButtons(status: presentation.status)","                if presentation.status.isEditingBlocked {","                    Text(\"Editing is paused; check the document's recovery status.\")","                }","            }","            .nativeHistory(binding)","        } else {","            ProgressView(\"Opening note…\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Supply a visible retry\/discard decision when "},{"type":"codeVoice","code":"status.requiresDraftDecision"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"true, and surface "},{"type":"codeVoice","code":"status.issue"},{"type":"text","text":" in your app’s error presentation. Do not blindly"},{"type":"text","text":" "},{"type":"text","text":"discard a draft to make the status message disappear."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Do not also install this editor in an AppKit\/UIKit parent. Let the wrapper own"},{"type":"text","text":" "},{"type":"text","text":"its visual placement. When values overlap during replacement, one container"},{"type":"text","text":" "},{"type":"text","text":"presents the editor and surviving waiters receive it in order. Do not infer that"},{"type":"text","text":" "},{"type":"codeVoice","code":".onDisappear"},{"type":"text","text":" means a native container was destroyed; SwiftUI can retain"},{"type":"text","text":" "},{"type":"text","text":"offscreen content."}],"type":"paragraph"},{"text":"Route explicit Undo controls","level":2,"anchor":"Route-explicit-Undo-controls","type":"heading"},{"inlineContent":[{"type":"text","text":"The modifier supplies UndoKit’s "},{"type":"codeVoice","code":"nativeHistoryUndoManager"},{"type":"text","text":" environment value."},{"type":"text","text":" "},{"type":"text","text":"A toolbar can obtain it without creating its own UndoManager:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiftUI","import UndoKit","","struct NoteUndoButtons: View {","    let status: HistorySessionStatus","    @Environment(\\.nativeHistoryUndoManager) private var history","","    var body: some View {","        HStack {","            Button(\"Undo\") { history?.undo() }","                .disabled(!status.canUndo)","            Button(\"Redo\") { history?.redo() }","                .disabled(!status.canRedo)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Place these controls "},{"type":"strong","inlineContent":[{"text":"inside","type":"text"}]},{"type":"text","text":" the subtree receiving "},{"type":"codeVoice","code":".nativeHistory(binding)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The observed owner forwards session status to these buttons so availability"},{"type":"text","text":" "},{"type":"text","text":"updates redraw them. Reading UndoManager properties alone does not subscribe a"},{"type":"text","text":" "},{"type":"text","text":"view to changes. The SDK’s built-in "},{"type":"codeVoice","code":"undoManager"},{"type":"text","text":" environment value is not the"},{"type":"text","text":" "},{"type":"text","text":"writable integration point. On Mac, also supply the binding’s manager to the"},{"type":"text","text":" "},{"type":"text","text":"window\/document responder route for Edit-menu commands and keyboard shortcuts."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Keep one editor\/binding per presentation in your stable owner. Rebuilding a view"},{"type":"text","text":" "},{"type":"text","text":"must not create another writer, replace the native manager, or lose pending and"},{"type":"text","text":" "},{"type":"text","text":"rejected drafts. Disconnect when the presentation is actually retired; close the"},{"type":"text","text":" "},{"type":"text","text":"shared session only when its document lifetime ends."}],"type":"paragraph"},{"text":"Run the complete apps","level":2,"anchor":"Run-the-complete-apps","type":"heading"},{"items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUIApp","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUI","type":"reference","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both share the same durable Note\/receipt host. They demonstrate rejected and"},{"type":"text","text":" "},{"type":"text","text":"pending drafts, remounting, native Undo\/Redo and explicit retry\/discard decisions."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/undokit\/swiftuiintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration"},"kind":"article","hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"]]},"seeAlsoSections":[{"anchor":"Get-started","identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"],"generated":true,"title":"Get started"}],"references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit/InstallingUndoKit":{"role":"collectionGroup","abstract":[{"text":"Select one dynamic runtime and resource owner per process.","type":"text"}],"title":"Installing UndoKit","kind":"article","type":"topic","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","url":"\/documentation\/undokit\/installingundokit"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryAttachment":{"role":"symbol","type":"topic","abstract":[{"text":"Connects one window or scene to a shared document session.","type":"text"}],"url":"\/documentation\/undokit\/historyattachment","kind":"symbol","title":"HistoryAttachment","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryAttachment","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistoryAttachment","kind":"identifier"}],"navigatorTitle":[{"text":"HistoryAttachment","kind":"identifier"}]},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/AppKitIntegration":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Bind native text views to a document’s typed operations and route the window’s UndoManager.","type":"text"}],"url":"\/documentation\/undokit\/appkitintegration","kind":"article","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","title":"Add history to an AppKit window"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HostingYourModel":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Replace the example’s domain host while keeping session and presentation wiring.","type":"text"}],"url":"\/documentation\/undokit\/hostingyourmodel","kind":"article","title":"Connect your own model","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"},"https://github.com/Folio-Suite/UndoKit/tree/main/Examples/DurableNotes/SwiftUIApp":{"type":"link","titleInlineContent":[{"text":"SwiftUI Mac","type":"text"}],"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUIApp","title":"SwiftUI Mac","url":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUIApp"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Durable Undo and Redo for Swift apps, with the native editing behavior people expect."}],"url":"\/documentation\/undokit","kind":"symbol","title":"UndoKit","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/NativeHistorySwiftUIEditor":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NativeHistorySwiftUIEditor","kind":"identifier"}],"navigatorTitle":[{"text":"NativeHistorySwiftUIEditor","kind":"identifier"}],"abstract":[{"type":"text","text":"Presents an existing AppKit-bound text view without replacing its native editor or Undo history."},{"type":"text","text":" "},{"type":"text","text":"Keep the "},{"type":"codeVoice","code":"textView"},{"type":"text","text":" and its binding in a stable window owner across SwiftUI value-view updates."}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/undokit\/nativehistoryswiftuieditor","title":"NativeHistorySwiftUIEditor","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/NativeHistorySwiftUIEditor"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/RecoveryAndStorage":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Preserve exact intent and authoritative evidence across uncertainty.","type":"text"}],"url":"\/documentation\/undokit\/recoveryandstorage","kind":"article","title":"Recovery, storage and concurrency","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/FirstUndoGroup":{"role":"article","type":"topic","abstract":[{"text":"Open a document, submit a typed edit, then Undo, Redo and reopen it.","type":"text"}],"url":"\/documentation\/undokit\/firstundogroup","kind":"article","title":"Your first Undo Group","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/UIKitIntegration":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Keep a native text view and its history binding with the scene’s document presentation.","type":"text"}],"url":"\/documentation\/undokit\/uikitintegration","kind":"article","title":"Add history to a UIKit scene","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration"},"https://github.com/Folio-Suite/UndoKit/tree/main/Examples/DurableNotes/SwiftUI":{"type":"link","titleInlineContent":[{"text":"SwiftUI iPhone\/iPad","type":"text"}],"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUI","title":"SwiftUI iPhone\/iPad","url":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUI"}}}