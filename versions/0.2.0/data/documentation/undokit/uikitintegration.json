{"topicSections":[{"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryAttachment","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessionStatus","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"],"anchor":"Topics"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/undokit\/uikitintegration"]}],"abstract":[{"text":"Keep a native text view and its history binding with the scene’s document presentation.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"]]},"sections":[],"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"NoteDocument"},{"type":"text","text":" wrapper from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup"},{"type":"text","text":". The application owns its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessions"},{"type":"text","text":" collection; the scene\/controller owns an attachment. Share a"},{"type":"text","text":" "},{"type":"text","text":"document owner between scenes that intentionally edit the same History Scope."}]},{"level":2,"text":"Connect the editor and responder","type":"heading","anchor":"Connect-the-editor-and-responder"},{"syntax":"swift","code":["import UIKit","import DurableNotesCore","import UndoKit","","@MainActor final class NoteViewController: UIViewController {","    let editor = NativeHistoryTextView()","    private(set) var attachment: HistoryAttachment?","    private(set) var binding: NativeHistoryUIKitBinding?","    override var undoManager: UndoManager? { attachment?.undoManager }","    override var canBecomeFirstResponder: Bool { true }","","    override func loadView() {","        view = editor","        editor.accessibilityLabel = \"Note body\"","    }","","    func connect(document: NoteDocument) async throws {","        loadViewIfNeeded()","        let attachment = try document.history.attach(owner: self)","        self.attachment = attachment","        binding = try await attachment.bindUIKit(editors: [","            (editor, try document.lease.field(.body, in: document.history))","        ])","    }","","    func disconnect() {","        binding?.disconnect()","        binding = nil","        attachment?.disconnect()","        attachment = nil","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Present the controller in your scene’s window and retain the document owner in"},{"type":"text","text":" "},{"type":"text","text":"your scene\/application model. The native text view supplies UndoKit’s manager"},{"type":"text","text":" "},{"type":"text","text":"while UIKit owns typing, selection, paste, marked composition and live Undo\/Redo."},{"type":"text","text":" "},{"type":"text","text":"Your explicit application controls can await "},{"type":"codeVoice","code":"attachment.undo()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"redo()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the binding’s delegate and input hooks installed. Use its "},{"type":"codeVoice","code":"permitsEditing"},{"type":"text","text":" "},{"type":"text","text":"status for your own controls as well; native input admission is enforced by the"},{"type":"text","text":" "},{"type":"text","text":"binding. A pending result does not grant a newly presented editor permission to"},{"type":"text","text":" "},{"type":"text","text":"change the document."}]},{"level":2,"text":"Commit, background and reopen","type":"heading","anchor":"Commit-background-and-reopen"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An explicit Save\/Commit action can await "},{"type":"codeVoice","code":"binding.commit()"},{"type":"text","text":". Inspect the result"},{"type":"text","text":" "},{"type":"text","text":"and session status before proceeding. Native editing-end boundaries also settle"},{"type":"text","text":" "},{"type":"text","text":"complete drafts. A submitted semantic operation uses the same shared session."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backgrounding and protected-data changes are ownership events, not permission"},{"type":"text","text":" "},{"type":"text","text":"to discard a pending effect. Stop admitting new UI work, give in-flight work a"},{"type":"text","text":" "},{"type":"text","text":"bounded background opportunity to reach a recoverable boundary, and retain a"},{"type":"text","text":" "},{"type":"text","text":"blocked owner if closure cannot finish. On return, close that owner successfully"},{"type":"text","text":" "},{"type":"text","text":"before reacquiring returned storage with "},{"type":"codeVoice","code":".existing"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/UIKit"},{"type":"text","text":" "},{"type":"text","text":"contains the complete scene lifecycle and protected-data handling. Start there"},{"type":"text","text":" "},{"type":"text","text":"for production lifecycle wiring; the controller above intentionally shows only"},{"type":"text","text":" "},{"type":"text","text":"the editor integration. Simulator observations do not establish physical locking,"},{"type":"text","text":" "},{"type":"text","text":"hardware-keyboard or IME behavior."}]}],"kind":"content"}],"metadata":{"role":"collectionGroup","title":"Add history to a UIKit scene","modules":[{"name":"UndoKit"}],"roleHeading":"API Collection"},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"],"anchor":"Get-started","title":"Get started"}],"identifier":{"url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","interfaceLanguage":"swift"},"references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit/InstallingUndoKit":{"role":"collectionGroup","abstract":[{"text":"Select one dynamic runtime and resource owner per process.","type":"text"}],"title":"Installing UndoKit","kind":"article","type":"topic","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","url":"\/documentation\/undokit\/installingundokit"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HostingYourModel":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Replace the example’s domain host while keeping session and presentation wiring.","type":"text"}],"url":"\/documentation\/undokit\/hostingyourmodel","kind":"article","title":"Connect your own model","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistorySessions":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistorySessions","kind":"identifier"}],"navigatorTitle":[{"text":"HistorySessions","kind":"identifier"}],"abstract":[{"text":"Retains the application’s open documents and their shared editing\/recovery owners.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/undokit\/historysessions","title":"HistorySessions","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessions"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/AppKitIntegration":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Bind native text views to a document’s typed operations and route the window’s UndoManager.","type":"text"}],"url":"\/documentation\/undokit\/appkitintegration","kind":"article","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","title":"Add history to an AppKit window"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistorySessionStatus":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistorySessionStatus","kind":"identifier"}],"navigatorTitle":[{"text":"HistorySessionStatus","kind":"identifier"}],"abstract":[],"type":"topic","role":"symbol","kind":"symbol","url":"\/documentation\/undokit\/historysessionstatus","title":"HistorySessionStatus","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessionStatus"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit":{"role":"collection","type":"topic","abstract":[{"type":"text","text":"Durable Undo and Redo for Swift apps, with the native editing behavior people expect."}],"url":"\/documentation\/undokit","kind":"symbol","title":"UndoKit","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"},"https://github.com/Folio-Suite/UndoKit/tree/main/Examples/DurableNotes/UIKit":{"type":"link","titleInlineContent":[{"text":"UIKit sample","type":"text"}],"title":"UIKit sample","identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/UIKit","url":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/UIKit"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/RecoveryAndStorage":{"role":"collectionGroup","type":"topic","abstract":[{"text":"Preserve exact intent and authoritative evidence across uncertainty.","type":"text"}],"url":"\/documentation\/undokit\/recoveryandstorage","kind":"article","title":"Recovery, storage and concurrency","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/SwiftUIIntegration":{"role":"collectionGroup","abstract":[{"text":"Let SwiftUI compose the screen while a stable owner retains the editor, binding and session.","type":"text"}],"title":"Present native history in SwiftUI","kind":"article","type":"topic","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration","url":"\/documentation\/undokit\/swiftuiintegration"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/FirstUndoGroup":{"role":"article","type":"topic","abstract":[{"text":"Open a document, submit a typed edit, then Undo, Redo and reopen it.","type":"text"}],"url":"\/documentation\/undokit\/firstundogroup","kind":"article","title":"Your first Undo Group","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryAttachment":{"role":"symbol","type":"topic","abstract":[{"text":"Connects one window or scene to a shared document session.","type":"text"}],"url":"\/documentation\/undokit\/historyattachment","kind":"symbol","title":"HistoryAttachment","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryAttachment","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HistoryAttachment","kind":"identifier"}],"navigatorTitle":[{"text":"HistoryAttachment","kind":"identifier"}]}}}