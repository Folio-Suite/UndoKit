{"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with the "},{"code":"NoteDocument","type":"codeVoice"},{"type":"text","text":" wrapper in "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","type":"reference","isActive":true},{"type":"text","text":". Create one"},{"text":" ","type":"text"},{"text":"presentation owner per window, sharing that wrapper when two windows show the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"same document. This example binds the body field; the runnable app also binds a"},{"type":"text","text":" "},{"type":"text","text":"title and demonstrates a local scratch editor."}]},{"anchor":"Connect-the-editor","level":2,"type":"heading","text":"Connect the editor"},{"code":["import AppKit","import DurableNotesCore","import UndoKit","","@MainActor final class NoteWindow: NSWindow {","    weak var historyManager: UndoManager?","    override var undoManager: UndoManager? { historyManager }","    @objc func undo(_ sender: Any?) { historyManager?.undo() }","    @objc func redo(_ sender: Any?) { historyManager?.redo() }","    override func validateUserInterfaceItem(_ item: any NSValidatedUserInterfaceItem) -> Bool {","        if item.action == #selector(undo(_:)) { return historyManager?.canUndo ?? false }","        if item.action == #selector(redo(_:)) { return historyManager?.canRedo ?? false }","        return super.validateUserInterfaceItem(item)","    }","}","","@MainActor final class NoteWindowHistory {","    let editor = NativeHistoryAppKitTextView()","    private(set) var attachment: HistoryAttachment?","    private(set) var binding: NativeHistoryAppKitBinding?","","    func connect(document: NoteDocument, window: NoteWindow) async throws {","        editor.isRichText = false","        editor.allowsUndo = true","        let attachment = try document.history.attach(owner: self)","        self.attachment = attachment","        binding = try await attachment.bindAppKit(editors: [","            (editor, try document.lease.field(.body, in: document.history))","        ])","        window.historyManager = attachment.undoManager","    }","","    func disconnect() {","        binding?.disconnect()","        binding = nil","        attachment?.disconnect()","        attachment = nil","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retain "},{"code":"NoteWindowHistory","type":"codeVoice"},{"type":"text","text":" in your window controller. Place its "},{"code":"editor","type":"codeVoice"},{"type":"text","text":" inside an"},{"type":"text","text":" "},{"code":"NSScrollView","type":"codeVoice"},{"type":"text","text":" and install that scroll view in the window’s content view. For an"},{"type":"text","text":" "},{"code":"NSDocument","type":"codeVoice"},{"type":"text","text":" app, provide the same attachment manager through the document’s"},{"type":"text","text":" "},{"type":"text","text":"normal UndoManager route instead of inventing another manager."}]},{"inlineContent":[{"type":"text","text":"The field declaration reads the authoritative value "},{"type":"strong","inlineContent":[{"type":"text","text":"and revision"}]},{"type":"text","text":" and maps a"},{"type":"text","text":" "},{"type":"text","text":"proposed string to the same "},{"type":"codeVoice","code":"NoteChange"},{"type":"text","text":" operation used by the rename button."},{"type":"text","text":" "},{"type":"text","text":"Binding installs the native editing hooks; do not replace its text-view delegate"},{"type":"text","text":" "},{"type":"text","text":"or register a second set of live Undo callbacks."}],"type":"paragraph"},{"level":2,"anchor":"Commit-and-report-readiness","type":"heading","text":"Commit and report readiness"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Await "},{"type":"codeVoice","code":"binding.commit()"},{"type":"text","text":" at an explicit "},{"type":"strong","inlineContent":[{"type":"text","text":"Commit typing"}]},{"type":"text","text":" action. Supported"},{"type":"text","text":" "},{"type":"text","text":"focus\/editing-end boundaries also settle drafts. An event-loop Undo group ending"},{"type":"text","text":" "},{"type":"text","text":"is not itself a request to persist each keystroke."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observe "},{"type":"codeVoice","code":"HistorySessionStatus"},{"type":"text","text":" through "},{"code":"session.attach(owner:statusDidChange:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when connecting. Use ","type":"text"},{"code":"binding.permitsEditing","type":"codeVoice"},{"text":" and the status to update controls","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and explain busy\/recovery states. Preserve marked text while composition finishes;"},{"type":"text","text":" "},{"type":"text","text":"do not overwrite a live draft from a background model refresh."}]},{"type":"paragraph","inlineContent":[{"text":"Before closing a window, settle its editing and handle rejection or recovery","type":"text"},{"text":" ","type":"text"},{"text":"visibly. Then disconnect its presentation. If it was the last owner of the","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"document"}],"type":"strong"},{"text":", explicitly await session closure and check ","type":"text"},{"code":".closed","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Try it","type":"heading","anchor":"Try-it","level":2},{"type":"paragraph","inlineContent":[{"text":"In the ","type":"text"},{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes","type":"reference","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"type, use Cmd-Z\/Shift-Cmd-Z, commit, then close and reopen. A local scratch editor","type":"text"},{"text":" ","type":"text"},{"text":"uses only its own history: an empty local Undo stack must not fall through to an","type":"text"},{"text":" ","type":"text"},{"text":"older document edit. Two windows for the same document share session ordering;","type":"text"},{"text":" ","type":"text"},{"text":"two different documents keep independent scopes.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/undokit\/appkitintegration"]}],"metadata":{"role":"collectionGroup","modules":[{"name":"UndoKit"}],"title":"Add history to an AppKit window","roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryAttachment","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryField","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"],"anchor":"Topics"}],"seeAlsoSections":[{"title":"Get started","identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"],"generated":true,"anchor":"Get-started"}],"abstract":[{"text":"Bind native text views to a document’s typed operations and route the window’s UndoManager.","type":"text"}],"references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit":{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","role":"collection","url":