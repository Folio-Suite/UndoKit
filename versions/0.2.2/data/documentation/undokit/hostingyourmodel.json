{"sections":[],"metadata":{"role":"collectionGroup","title":"Connect your own model","roleHeading":"API Collection","modules":[{"name":"UndoKit"}]},"seeAlsoSections":[{"anchor":"Get-started","identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration"],"title":"Get started","generated":true}],"primaryContentSections":[{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The platform guides use ","type":"text"},{"code":"DurableNotesCore","type":"codeVoice"},{"text":" so the storage and recovery contract is","type":"text"},{"text":" ","type":"text"},{"text":"runnable rather than hidden behind placeholders. Your app supplies the equivalent","type":"text"},{"text":" ","type":"text"},{"text":"of its ","type":"text"},{"code":"NoteChange","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DurableNotesHost","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"NotesDocumentLease","type":"codeVoice"},{"text":". You do not need to","type":"text"},{"text":" ","type":"text"},{"text":"adopt its JSON datastore or expose UndoKit’s storage internals.","type":"text"}]},{"level":2,"anchor":"Define-one-semantic-operation","type":"heading","text":"Define one semantic operation"},{"type":"paragraph","inlineContent":[{"text":"A Command describes ","type":"text"},{"inlineContent":[{"type":"text","text":"intent"}],"type":"strong"},{"text":", such as replacing a title only if it still has","type":"text"},{"text":" ","type":"text"},{"text":"an expected value. An effect records enough information to undo and redo an","type":"text"},{"text":" ","type":"text"},{"text":"accepted change. They can be the same Swift type, as in Durable Notes, or different","type":"text"},{"text":" ","type":"text"},{"text":"types. Keep them transferable when using ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryOperation","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Register each operation once with a stable family, versioned codecs, actual host","type":"text"},{"text":" ","type":"text"},{"text":"handler and canonical Intent Fingerprint. This excerpt is the sample’s declaration,","type":"text"},{"text":" ","type":"text"},{"text":"created after opening its domain host:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Foundation","import DurableNotesCore","import UndoKit","","func noteOperation<Handler: HistoryOperationHandler>(","    handler: Handler",") throws -> HistoryOperation<NoteChange>","where Handler.Command == NoteChange, Handler.Effect == NoteChange {","    try HistoryOperation(","        operation: \"durable-notes.change\",","        commandCodec: .json(), effectCodec: .json(), handler: handler,","        fingerprint: { changes in","            let encoder = JSONEncoder()","            encoder.outputFormatting = [.sortedKeys]","            return try encoder.encode(changes)","        },","        metadata: { changes in","            let name = changes.count == 1 ? changes[0].field.rawValue : \"note\"","            return HistoryOperationMetadata(presentation: HistoryPayload(","                family: \"durable-notes.action\", data: Data(name.utf8)))","        })","}"]},{"type":"paragraph","inlineContent":[{"text":"This sample metadata uses ","type":"text"},{"code":"durable-notes.action","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"note","type":"codeVoice"},{"text":" ","type":"text"},{"text":"as its data. A host can decode it to localized menu names through the session’s","type":"text"},{"text":" ","type":"text"},{"text":"optional native action-name resolver; UndoKit stores and returns the payload","type":"text"},{"text":" ","type":"text"},{"text":"without interpreting it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Keep this declaration and its handler for the session lifetime. Recreating a","type":"text"},{"text":" ","type":"text"},{"text":"lookalike operation for each button press does not preserve registration identity.","type":"text"},{"text":" ","type":"text"},{"text":"Get ","type":"text"},{"code":"session.commands(for: operation)","type":"codeVoice"},{"text":" once, then pass that typed handle to your","type":"text"},{"text":" ","type":"text"},{"text":"editing code. Fingerprints represent canonical intent; they are not a fresh UUID","type":"text"},{"text":" ","type":"text"},{"text":"or a claim that a previous request succeeded.","type":"text"}]},{"level":2,"anchor":"Apply-effects-and-receipts-together","type":"heading","text":"Apply effects and receipts together"},{"type":"paragraph","inlineContent":[{"text":"Implement ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryOperationHandler","type":"reference","isActive":true},{"text":" on an actor, or","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/MainActorHistoryOperationHandler","type":"reference","isActive":true},{"text":" when the domain belongs on MainActor. Both","type":"text"},{"text":" ","type":"text"},{"text":"provide ","type":"text"},{"code":"apply","type":"codeVoice"},{"text":", ","type":"text"},{"code":"undo","type":"codeVoice"},{"text":", ","type":"text"},{"code":"redo","type":"codeVoice"},{"text":" and authoritative ","type":"text"},{"code":"outcome(for:)","type":"codeVoice"},{"text":" lookup.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For each delivered group:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Look up its complete token in your durable receipt store. If it already has an","type":"text"},{"text":" ","type":"text"},{"text":"outcome, return that outcome without applying effects again.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Validate "},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"type":"text","text":" members against the current domain state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Commit the group’s complete effect and token-bound receipt atomically in your"},{"type":"text","text":" "},{"type":"text","text":"own datastore. Never accept a partial group."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Return the corresponding typed effects, preserving each delivered member ID."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Undo and Redo are new deliveries with their own tokens. Their effects and receipts"},{"type":"text","text":" "},{"type":"text","text":"follow the same atomicity rule. For a mixed-family atomic group, provide the paired"},{"type":"text","text":" "},{"type":"text","text":"atomic executor\/outcome callbacks in "},{"isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessionSetup","type":"reference"},{"type":"text","text":"; independent family"},{"type":"text","text":" "},{"type":"text","text":"callbacks cannot establish a shared atomic commit."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sample commits its note and receipts in one atomic JSON-file replacement"},{"text":" ","type":"text"},{"type":"text","text":"under an exclusive writer lock. A Core Data host would normally persist them in"},{"text":" ","type":"text"},{"type":"text","text":"one coordinated domain transaction instead. This is your application’s transaction,"},{"text":" ","type":"text"},{"type":"text","text":"separate from UndoKit’s history finalization."}]},{"inlineContent":[{"type":"text","text":"If a write might have succeeded, return "},{"type":"codeVoice","code":".unresolved"},{"type":"text","text":" until authoritative lookup"},{"type":"text","text":" "},{"type":"text","text":"can prove its outcome. A timeout or thrown write is not proof of rejection."},{"type":"text","text":" "},{"type":"text","text":"The sample reloads its file before answering recovery lookup. It can treat a"},{"type":"text","text":" "},{"type":"text","text":"missing token in an intact file as rejection only because its single-writer,"},{"type":"text","text":" "},{"text":"atomic-file contract proves that no corresponding effect committed.","type":"text"}],"type":"paragraph"},{"anchor":"Give-the-session-a-domain-lease","text":"Give the session a domain lease","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryHostLease","isActive":true,"type":"reference"},{"type":"text","text":" acquires and releases only your domain resources. Its"},{"type":"text","text":" "},{"type":"text","text":"initializer must not acquire them: the application collection retains ownership"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" calling "},{"type":"codeVoice","code":"open"},{"type":"text","text":". Use the asynchronous configure closure when operation"},{"type":"text","text":" "},{"type":"text","text":"setup needs the opened host, as shown in "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The returned "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessionSetup","isActive":true,"type":"reference"},{"type":"text","text":" names the history URL, stable scope and"},{"type":"text","text":" "},{"type":"text","text":"working identity and registered operations. UndoKit opens\/closes its own storage"},{"type":"text","text":" "},{"type":"text","text":"and journals, then releases the domain lease after successful closure. A failed"},{"type":"text","text":" "},{"type":"text","text":"close keeps the responsible owner. Reuse the same lease when reopening an already"},{"type":"text","text":" "},{"type":"text","text":"live document; prefer sharing the document wrapper rather than opening it twice."}],"type":"paragraph"},{"anchor":"Map-native-fields","text":"Map native fields","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryField","type":"reference","isActive":true},{"text":" declares a stable field ID and mapping ID, codec, typed handle,","type":"text"},{"text":" ","type":"text"},{"text":"authoritative value\/revision read and a mapping from the base snapshot plus","type":"text"},{"text":" ","type":"text"},{"text":"proposed value to Commands. Return an empty array for a known no-op. Equal visible","type":"text"},{"text":" ","type":"text"},{"text":"values are not enough to establish that the authoritative revision is unchanged.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The sample uses its application counter as the revision because all its accepted","type":"text"},{"text":" ","type":"text"},{"text":"changes pass through one writer. Use your domain’s real revision scheme when","type":"text"},{"text":" ","type":"text"},{"text":"other writers or external edits are possible. Bind this field through the native","type":"text"},{"text":" ","type":"text"},{"text":"platform adapters; they handle draft capture, settlement and refresh.","type":"text"}],"type":"paragraph"},{"anchor":"Keep-ordinary-call-sites-small","text":"Keep ordinary call sites small","type":"heading","level":2},{"inlineContent":[{"text":"A rename button should submit a typed rename. It should not assemble payloads,","type":"text"},{"text":" ","type":"text"},{"text":"manage a retry identity, take a whole-document snapshot or open its own history","type":"text"},{"text":" ","type":"text"},{"text":"store. Use ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryStore","type":"reference","isActive":true},{"text":"\/","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryEngine","type":"reference","isActive":true},{"text":" directly only for a deliberately","type":"text"},{"text":" ","type":"text"},{"text":"lower-level integration; do not open a competing owner beneath a shared session.","type":"text"}],"type":"paragraph"},{"anchor":"Source-to-study","text":"Source to study","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/blob\/main\/Examples\/DurableNotes\/Sources\/DurableNotesCore\/Note.swift","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/blob\/main\/Examples\/DurableNotes\/Sources\/DurableNotesCore\/DurableNotesHost.swift","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/blob\/main\/Examples\/DurableNotes\/Sources\/DurableNotesCore\/NotesDocumentLease.swift","type":"reference"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/undokit\/hostingyourmodel"]}],"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYo