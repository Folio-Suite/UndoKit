{"topicSections":[{"anchor":"Topics","identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryFailure","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryStore","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryEngine","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryHost","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RetainedHistoryAndResources","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/PreviewCompatibilityAndSupport"]}],"metadata":{"role":"collectionGroup","modules":[{"name":"UndoKit"}],"title":"Recovery, storage and concurrency","roleHeading":"API Collection"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/undokit\/recoveryandstorage"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Preserve exact intent and authoritative evidence across uncertainty.","type":"text"}],"seeAlsoSections":[{"anchor":"Recovery-and-retained-history","identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RetainedHistoryAndResources","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/PreviewCompatibilityAndSupport","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryFailure","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryReading","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryRetentionManaging"],"title":"Recovery and retained history","generated":true}],"primaryContentSections":[{"content":[{"level":2,"text":"Show the next action","anchor":"Show-the-next-action","type":"heading"},{"inlineContent":[{"type":"text","text":"Keep session status visible to the person editing the document. A disabled"},{"type":"text","text":" "},{"type":"text","text":"editor without an explanation is difficult to distinguish from a broken app."}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"What you observe"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Next step"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Busy delivery"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the owner; wait for the authoritative result."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"requiresDraftDecision","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Offer "},{"code":"retryDraft()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"discardDraft()","type":"codeVoice"},{"type":"text","text":" with an explanation of the retained draft."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Suspended transaction"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Await "},{"code":"session.reconcile()","type":"codeVoice"},{"type":"text","text":"; it consults the original host receipt."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage unavailable"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Restore access to the original document, then finish closure before reopening it."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Close did not reach "},{"code":".closed","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the session\/domain lease and report the blocking issue."}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Use the session or binding’s supported methods, rather than clearing native"},{"type":"text","text":" "},{"type":"text","text":"registrations, resetting a generation or opening another history store. A retry"},{"type":"text","text":" "},{"type":"text","text":"of a retained draft and a new Command are different operations."}],"type":"paragraph"},{"level":2,"text":"Acceptance is host-authoritative","anchor":"Acceptance-is-host-authoritative","type":"heading"},{"inlineContent":[{"type":"text","text":"The host’s domain state and outcome receipt must agree atomically. If a delivery"},{"type":"text","text":" "},{"type":"text","text":"may have changed state, report unresolved until authoritative lookup establishes"},{"type":"text","text":" "},{"type":"text","text":"acceptance or rejection. UndoKit preserves prepared intent and suspends unsafe"},{"type":"text","text":" "},{"type":"text","text":"inverses while it reconciles. Never invent a fresh identity, clear unknown native"},{"type":"text","text":" "},{"type":"text","text":"registrations, or fall through to an older group to escape this uncertainty."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The durable samples include a Debug-only control that accepts an effect before"},{"type":"text","text":" "},{"type":"text","text":"history finalization fails. Graceful close\/reopen then recovers the original"},{"type":"text","text":" "},{"type":"text","text":"Accepted Outcome using its authoritative receipt without duplicating the effect."},{"type":"text","text":" "},{"type":"text","text":"This is injected production-boundary recovery evidence, not abrupt-termination"},{"type":"text","text":" "},{"type":"text","text":"certification. Release builds omit the Debug injection control."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A reopened retained draft is decision-gated. The host explicitly retries or"},{"type":"text","text":" "},{"type":"text","text":"discards the preserved draft; ordinary editing does not silently accept it."},{"type":"text","text":" "},{"type":"text","text":"App-owned session collections retain blocked complete leases after presentation"},{"type":"text","text":" "},{"type":"text","text":"is released. Close the blocked session before reopening storage that has returned."}],"type":"paragraph"},{"level":2,"text":"Preserve original storage","anchor":"Preserve-original-storage","type":"heading"},{"inlineContent":[{"type":"text","text":"Missing known history, corrupt bytes, an incompatible model or an identity"},{"type":"text","text":" "},{"type":"text","text":"conflict must be refused and preserved. Do not silently replace them with empty"},{"type":"text","text":" "},{"type":"text","text":"history or reset a generation. "},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryStore","type":"reference","isActive":true},{"type":"text","text":" opening validates supported model"},{"type":"text","text":" "},{"type":"text","text":"and identity before writable access; the host still coordinates external writers,"},{"type":"text","text":" "},{"type":"text","text":"moves, document resources and copies."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A coordinated copy pairs closed history with coherent host data and dependencies."},{"type":"text","text":" "},{"type":"text","text":"Unresolved work blocks an ordinary independent copy. Storage capacity checks can"},{"type":"text","text":" "},{"type":"text","text":"refuse before copying. History is not the primary datastore or a backup for"},{"type":"text","text":" "},{"type":"text","text":"missing host resources. Keep a recoverable coherent original for any supported"},{"type":"text","text":" "},{"type":"text","text":"upgrade; there is no downgrade guarantee."}],"type":"paragraph"},{"level":2,"text":"Respect actor and lifecycle ownership","anchor":"Respect-actor-and-lifecycle-ownership","type":"heading"},{"inlineContent":[{"type":"text","text":"Session\/capability calls and native presentation are MainActor isolated. A host"},{"type":"text","text":" "},{"type":"text","text":"handler may own another actor; immutable encoded values cross that boundary."},{"type":"text","text":" "},{"type":"text","text":"Applications establish intended submission order before admission. Each scope"},{"type":"text","text":" "},{"type":"text","text":"serializes delivery, but do not await another submission to the same scope from"},{"type":"text","text":" "},{"type":"text","text":"inside its host callback."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Cancellation after delivery cannot retract its semantic effect. Presentation"},{"type":"text","text":" "},{"type":"text","text":"teardown disconnects recognized callback graphs while the app retains recovery"},{"type":"text","text":" "},{"type":"text","text":"ownership as needed. Call explicit close and await delivered work reaching a"},{"type":"text","text":" "},{"type":"text","text":"recoverable boundary before releasing the domain lease. A disappearing window"},{"type":"text","text":" "},{"type":"text","text":"is not a guarantee that persistence succeeded."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration"],["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration"]]},"identifier":{"url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage","interfaceLanguage":"swift"},"sections":[],"kind":"article","references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit/InstallingUndoKit":{"url":"\/documentation\/undokit\/installingundokit","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","kind":"article","role":"collectionGroup","title":"Installing UndoKit","type":"topic","abstract":[{"type":"text","text":"Select one dynamic runtime and resource owner per process."}]},"doc://dev.foliosuite.UndoKit/documentation/UndoKit":{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit","role":"collection","url":"\/documentation\/undokit","title":"UndoKit","abstract":[{"text":"Durable Undo and Redo for Swift apps, with the native editing behavior people expect.","type":"text"}],"type":"topic","kind":"symbol"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryRetentionManaging":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"HistoryRetentionManaging"}],"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryRetentionManaging","url":"\/documentation\/undokit\/historyretentionmanaging","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistoryRetentionManaging"}],"abstract":[{"type":"text","text":"Host-directed checkpoint, hold and consolidation operations for one History Scope."}],"title":"HistoryRetentionManaging"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/SwiftUIIntegration":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration","url":"\/documentation\/undokit\/swiftuiintegration","type":"topic","abstract":[{"type":"text","text":"Let SwiftUI compose the screen while a stable owner retains the editor, binding and session."}],"title":"Present native history in SwiftUI"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryReading":{"navigatorTitle":[{"kind":"identifier","text":"HistoryReading"}],"url":"\/documentation\/undokit\/historyreading","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistoryReading"}],"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryReading","kind":"symbol","role":"symbol","title":"HistoryReading","type":"topic","abstract":[{"type":"text","text":"Bounded historical reads, presentation and host-directed reconstruction."}]},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryHost":{"navigatorTitle":[{"kind":"identifier","text":"HistoryHost"}],"url":"\/documentation\/undokit\/historyhost","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistoryHost"}],"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryHost","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A host adapter must persist an accepted receipt with its semantic mutation."},{"type":"text","text":" "},{"type":"text","text":"Implementations may be isolated to any actor. Only opaque, Sendable history"},{"type":"text","text":" "},{"type":"text","text":"values cross this boundary; domain values remain on the host’s actor."},{"type":"text","text":" "},{"type":"text","text":"Outcome lookup never applies a command again."}],"type":"topic","title":"HistoryHost"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HostingYourModel":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel","url":"\/documentation\/undokit\/hostingyourmodel","type":"topic","abstract":[{"type":"text","text":"Replace the example’s domain host while keeping session and presentation wiring."}],"title":"Connect your own model"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/AppKitIntegration":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","url":"\/documentation\/undokit\/appkitintegration","type":"topic","abstract":[{"type":"text","text":"Bind native text views to a document’s typed operations and route the window’s UndoManager."}],"title":"Add history to an AppKit window"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/RetainedHistoryAndResources":{"url":"\/documentation\/undokit\/retainedhistoryandresources","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RetainedHistoryAndResources","kind":"article","role":"collectionGroup","title":"Retained history, checkpoints and resources","type":"topic","abstract":[{"type":"text","text":"Browsing retained History does not move ordinary Undo\/Redo position."}]},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryStore":{"abstract":[{"text":"Physical owner of a registered SQLite history store and its independent scopes.","type":"text"},{"text":" ","type":"text"},{"text":"The host chooses and coordinates the location. A writable session holds one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"exclusive owner lock; readers may inspect committed records concurrently."}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"HistoryStore","kind":"identifier"}],"title":"HistoryStore","type":"topic","url":"\/documentation\/undokit\/historystore","navigatorTitle":[{"text":"HistoryStore","kind":"identifier"}],"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryStore","kind":"symbol","role":"symbol"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/UIKitIntegration":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","url":"\/documentation\/undokit\/uikitintegration","type":"topic","abstract":[{"type":"text","text":"Keep a native text view and its history binding with the scene’s document presentation."}],"title":"Add history to a UIKit scene"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryFailure":{"navigatorTitle":[{"kind":"identifier","text":"HistoryFailure"}],"url":"\/documentation\/undokit\/historyfailure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistoryFailure"}],"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryFailure","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A typed failure. Underlying text is diagnostic and never changes the disposition."}],"type":"topic","title":"HistoryFailure"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HistoryEngine":{"kind":"symbol","title":"HistoryEngine","abstract":[{"text":"An open History Scope and its lifecycle controls.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"HistoryEngine"}],"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryEngine","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"HistoryEngine"}],"url":"\/documentation\/undokit\/historyengine"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/PreviewCompatibilityAndSupport":{"kind":"article","role":"article","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/PreviewCompatibilityAndSupport","url":"\/documentation\/undokit\/previewcompatibilityandsupport","type":"topic","abstract":[{"type":"text","text":"Distinguish intended support, actual qualification and published identity."}],"title":"Beta compatibility and support"}}}