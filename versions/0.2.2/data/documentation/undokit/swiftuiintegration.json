{"topicSections":[{"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/NativeHistorySwiftUIEditor","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryAttachment","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"],"anchor":"Topics"}],"metadata":{"role":"collectionGroup","modules":[{"name":"UndoKit"}],"title":"Present native history in SwiftUI","roleHeading":"API Collection"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/undokit\/swiftuiintegration"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Let SwiftUI compose the screen while a stable owner retains the editor, binding and session.","type":"text"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/InstallingUndoKit","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel"],"anchor":"Get-started","title":"Get started"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Use the document setup in ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","type":"reference","isActive":true},{"text":" and the appropriate native binding","type":"text"},{"text":" ","type":"text"},{"text":"from ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/AppKitIntegration","type":"reference","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration","type":"reference","isActive":true},{"text":". ","type":"text"},{"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/NativeHistorySwiftUIEditor","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"presents that ","type":"text"},{"inlineContent":[{"type":"text","text":"existing"}],"type":"strong"},{"text":" editor. It does not open another session or turn a","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI ","type":"text"},{"code":"TextEditor","type":"codeVoice"},{"text":" into durable history.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Keep native objects outside the view value","anchor":"Keep-native-objects-outside-the-view-value","type":"heading"},{"inlineContent":[{"text":"This presentation owner holds one bound native editor and publishes session","type":"text"},{"text":" ","type":"text"},{"text":"status. It shares the ","type":"text"},{"code":"NoteDocument","type":"codeVoice"},{"text":" from the first guide rather than opening its","type":"text"},{"text":" ","type":"text"},{"text":"own session. The platform-specific part is only the native editor and binding:","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import UndoKit","#if canImport(AppKit)","import AppKit","#elseif canImport(UIKit)","import UIKit","#endif","","@MainActor final class SwiftUINotePresentation: ObservableObject {","    #if canImport(AppKit)","    let editor = NativeHistoryAppKitTextView()","    @Published private(set) var binding: NativeHistoryAppKitBinding?","    #else","    let editor = NativeHistoryTextView()","    @Published private(set) var binding: NativeHistoryUIKitBinding?","    #endif","    @Published private(set) var status: HistorySessionStatus","    private let document: NoteDocument","    private var attachment: HistoryAttachment?","","    init(document: NoteDocument) {","        self.document = document","        status = document.history.status","    }","","    func connect() async throws {","        guard attachment == nil else { return }","        let attachment = try document.history.attach(owner: self) { owner, status in","            owner.status = status","        }","        self.attachment = attachment","        do {","            let body = try document.lease.field(.body, in: document.history)","            #if canImport(AppKit)","            editor.isRichText = false","            editor.allowsUndo = true","            binding = try await attachment.bindAppKit(editors: [(editor, body)])","            #else","            binding = try await attachment.bindUIKit(editors: [(editor, body)])","            #endif","        } catch {","            attachment.disconnect()","            self.attachment = nil","            throw error","        }","    }","","    func disconnect() {","        binding?.disconnect()","        binding = nil","        attachment?.disconnect()","        attachment = nil","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Keep this owner in your application’s scene\/document model (for example with","type":"text"},{"text":" ","type":"text"},{"code":"@StateObject","type":"codeVoice"},{"text":"). Await ","type":"text"},{"code":"connect()","type":"codeVoice"},{"text":" before presenting the editor and display any","type":"text"},{"text":" ","type":"text"},{"text":"opening error. The view observes the existing owner:","type":"text"}],"type":"paragraph"},{"code":["@MainActor struct NoteEditor: View {","    @ObservedObject var presentation: SwiftUINotePresentation","","    var body: some View {","        if let binding = presentation.binding {","            VStack {","                NativeHistorySwiftUIEditor(textView: presentation.editor)","                NoteUndoButtons(status: presentation.status)","                if presentation.status.isEditingBlocked {","                    Text(\"Editing is paused; check the document's recovery status.\")","                }","            }","            .nativeHistory(binding)","        } else {","            ProgressView(\"Opening note…\")","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Supply a visible retry\/discard decision when ","type":"text"},{"code":"status.requiresDraftDecision","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"true, and surface ","type":"text"},{"code":"status.issue","type":"codeVoice"},{"text":" in your app’s error presentation. Do not blindly","type":"text"},{"text":" ","type":"text"},{"text":"discard a draft to make the status message disappear.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Do not also install this editor in an AppKit\/UIKit parent. Let the wrapper own","type":"text"},{"text":" ","type":"text"},{"text":"its visual placement. When values overlap during replacement, one container","type":"text"},{"text":" ","type":"text"},{"text":"presents the editor and surviving waiters receive it in order. Do not infer that","type":"text"},{"text":" ","type":"text"},{"code":".onDisappear","type":"codeVoice"},{"text":" means a native container was destroyed; SwiftUI can retain","type":"text"},{"text":" ","type":"text"},{"text":"offscreen content.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Route explicit Undo controls","anchor":"Route-explicit-Undo-controls","type":"heading"},{"inlineContent":[{"text":"The modifier supplies UndoKit’s ","type":"text"},{"code":"nativeHistoryUndoManager","type":"codeVoice"},{"text":" environment value.","type":"text"},{"text":" ","type":"text"},{"text":"A toolbar can obtain it without creating its own UndoManager:","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import UndoKit","","struct NoteUndoButtons: View {","    let status: HistorySessionStatus","    @Environment(\\.nativeHistoryUndoManager) private var history","","    var body: some View {","        HStack {","            Button(\"Undo\") { history?.undo() }","                .disabled(!status.canUndo)","            Button(\"Redo\") { history?.redo() }","                .disabled(!status.canRedo)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Place these controls ","type":"text"},{"inlineContent":[{"type":"text","text":"inside"}],"type":"strong"},{"text":" the subtree receiving ","type":"text"},{"code":".nativeHistory(binding)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The observed owner forwards session status to these buttons so availability","type":"text"},{"text":" ","type":"text"},{"text":"updates redraw them. Reading UndoManager properties alone does not subscribe a","type":"text"},{"text":" ","type":"text"},{"text":"view to changes. The SDK’s built-in ","type":"text"},{"code":"undoManager","type":"codeVoice"},{"text":" environment value is not the","type":"text"},{"text":" ","type":"text"},{"text":"writable integration point. On Mac, also supply the binding’s manager to the","type":"text"},{"text":" ","type":"text"},{"text":"window\/document responder route for Edit-menu commands and keyboard shortcuts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Keep one editor\/binding per presentation in your stable owner. Rebuilding a view","type":"text"},{"text":" ","type":"text"},{"text":"must not create another writer, replace the native manager, or lose pending and","type":"text"},{"text":" ","type":"text"},{"text":"rejected drafts. Disconnect when the presentation is actually retired; close the","type":"text"},{"text":" ","type":"text"},{"text":"shared session only when its document lifetime ends.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Run the complete apps","anchor":"Run-the-complete-apps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUIApp","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/SwiftUI","type":"reference","isActive":true}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Both share the same durable Note\/receipt host. They demonstrate rejected and","type":"text"},{"text":" ","type":"text"},{"text":"pending drafts, remounting, native Undo\/Redo and explicit retry\/discard decisions.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"]]},"identifier":{"url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/SwiftUIIntegration","interfaceLanguage":"swift"},"sections":[],"kind":"article","references":{"doc://dev.foliosuite.UndoKit/documentation/UndoKit/NativeHistorySwiftUIEditor":{"kind":"symbol","role":"symbol","navigatorTitle":[{"text":"NativeHistorySwiftUIEditor","kind":"identifier"}],"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/NativeHistorySwiftUIEditor","url":"\/documentation\/undokit\/nativehistoryswiftuieditor","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NativeHistorySwiftUIEditor","kind":"identifier"}],"abstract":[{"type":"text","text":"Presents an existing AppKit-bound text view without replacing its native editor or Undo history."},{"type":"text","text":" "},{"type":"text","text":"Keep the "},{"type":"codeVoice","code":"textView"},{"type":"text","text":" and its binding in a stable window owner across SwiftUI value-view updates."}],"title":"NativeHistorySwiftUIEditor"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/HostingYourModel":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HostingYourModel","url":"\/documentation\/undokit\/hostingyourmodel","type":"topic","abstract":[{"type":"text","text":"Replace the example’s domain host while keeping session and presentation wiring."}],"title":"Connect your own model"},"doc://dev.foliosuite.UndoKit/documentation/UndoKit/RecoveryAndStorage":{"url":"\/documentat