{"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":"NoteDocument","type":"codeVoice"},{"type":"text","text":" wrapper from "},{"isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/FirstUndoGroup","type":"reference"},{"type":"text","text":". The application owns its"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessions","type":"reference"},{"type":"text","text":" collection; the scene\/controller owns an attachment. Share a"},{"type":"text","text":" "},{"type":"text","text":"document owner between scenes that intentionally edit the same History Scope."}]},{"type":"heading","anchor":"Connect-the-editor-and-responder","text":"Connect the editor and responder","level":2},{"code":["import UIKit","import DurableNotesCore","import UndoKit","","@MainActor final class NoteViewController: UIViewController {","    let editor = NativeHistoryTextView()","    private(set) var attachment: HistoryAttachment?","    private(set) var binding: NativeHistoryUIKitBinding?","    override var undoManager: UndoManager? { attachment?.undoManager }","    override var canBecomeFirstResponder: Bool { true }","","    override func loadView() {","        view = editor","        editor.accessibilityLabel = \"Note body\"","    }","","    func connect(document: NoteDocument) async throws {","        loadViewIfNeeded()","        let attachment = try document.history.attach(owner: self)","        self.attachment = attachment","        binding = try await attachment.bindUIKit(editors: [","            (editor, try document.lease.field(.body, in: document.history))","        ])","    }","","    func disconnect() {","        binding?.disconnect()","        binding = nil","        attachment?.disconnect()","        attachment = nil","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Present the controller in your scene’s window and retain the document owner in"},{"type":"text","text":" "},{"type":"text","text":"your scene\/application model. The native text view supplies UndoKit’s manager"},{"type":"text","text":" "},{"type":"text","text":"while UIKit owns typing, selection, paste, marked composition and live Undo\/Redo."},{"type":"text","text":" "},{"type":"text","text":"Your explicit application controls can await "},{"code":"attachment.undo()","type":"codeVoice"},{"type":"text","text":" and "},{"code":"redo()","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the binding’s delegate and input hooks installed. Use its "},{"code":"permitsEditing","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"status for your own controls as well; native input admission is enforced by the"},{"type":"text","text":" "},{"type":"text","text":"binding. A pending result does not grant a newly presented editor permission to"},{"type":"text","text":" "},{"type":"text","text":"change the document."}]},{"type":"heading","anchor":"Commit-background-and-reopen","text":"Commit, background and reopen","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An explicit Save\/Commit action can await "},{"code":"binding.commit()","type":"codeVoice"},{"type":"text","text":". Inspect the result"},{"type":"text","text":" "},{"type":"text","text":"and session status before proceeding. Native editing-end boundaries also settle"},{"type":"text","text":" "},{"type":"text","text":"complete drafts. A submitted semantic operation uses the same shared session."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backgrounding and protected-data changes are ownership events, not permission"},{"type":"text","text":" "},{"type":"text","text":"to discard a pending effect. Stop admitting new UI work, give in-flight work a"},{"type":"text","text":" "},{"type":"text","text":"bounded background opportunity to reach a recoverable boundary, and retain a"},{"type":"text","text":" "},{"type":"text","text":"blocked owner if closure cannot finish. On return, close that owner successfully"},{"type":"text","text":" "},{"type":"text","text":"before reacquiring returned storage with "},{"code":".existing","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"https:\/\/github.com\/Folio-Suite\/UndoKit\/tree\/main\/Examples\/DurableNotes\/UIKit","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"contains the complete scene lifecycle and protected-data handling. Start there"},{"type":"text","text":" "},{"type":"text","text":"for production lifecycle wiring; the controller above intentionally shows only"},{"type":"text","text":" "},{"type":"text","text":"the editor integration. Simulator observations do not establish physical locking,"},{"type":"text","text":" "},{"type":"text","text":"hardware-keyboard or IME behavior."}]}]}],"variants":[{"paths":["\/documentation\/undokit\/uikitintegration"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"collectionGroup","title":"Add history to a UIKit scene","modules":[{"name":"UndoKit"}],"roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/UIKitIntegration"},"topicSections":[{"identifiers":["doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistoryAttachment","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/HistorySessionStatus","doc:\/\/dev.foliosuite.UndoKit\/documentation\/UndoKit\/RecoveryAndStorage"],"anchor":"Topics"}],"seeAlsoSections":[{"ge